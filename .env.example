# Copy to .env and fill in before `docker compose up`.

# Required — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Optional — SMTP for reminder emails (REQUIREMENTS.md: email-only notifications).
# Leave unset to run without real email delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=habit-tracker@example.com

# Optional — comma-separated frontend origin(s), e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=
